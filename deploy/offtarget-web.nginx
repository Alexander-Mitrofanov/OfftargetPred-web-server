limit_req_zone $binary_remote_addr zone=offtarget_submit:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=offtarget_read:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=offtarget_clients:10m;
limit_conn_zone $server_name zone=offtarget_global:1m;
server {
    listen 127.0.0.1:8082 proxy_protocol;
    server_name _;
    server_tokens off;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    client_max_body_size 5m;
    client_body_timeout 20s;
    send_timeout 30s;
    access_log off;
    error_log /var/log/nginx/offtarget-error.log crit;
    client_body_temp_path /srv/crispert/nginx-body 1 2;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    limit_conn offtarget_clients 6;
    limit_conn offtarget_global 32;
    limit_conn_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    limit_req_status 429;
    location = /api/v1/jobs {
        limit_req zone=offtarget_submit burst=5 nodelay;
        limit_conn offtarget_clients 1;
        limit_conn offtarget_global 4;
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
    location /api/v1/ {
        limit_req zone=offtarget_read burst=30 nodelay;
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
    location / { return 404; }
}
