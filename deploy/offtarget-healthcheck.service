[Unit]
Description=OfftargetPred operational readiness snapshot
After=network-online.target
RequiresMountsFor=/srv/crispert
ConditionPathIsMountPoint=/srv/crispert

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /srv/crispert/current/deploy/healthcheck.py --state /var/lib/offtarget-operations/health.json --monitor
TimeoutStartSec=90
StateDirectory=offtarget-operations
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/offtarget-operations
# No access to sequences, capability database, upload bodies or private SSH keys.
InaccessiblePaths=-/srv/crispert/data -/srv/crispert/nginx-body -/srv/crispert/tmp -/var/lib/tailscale -/root/.ssh
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LimitCORE=0
MemoryMax=256M
TasksMax=64
